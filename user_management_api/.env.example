# Copy to `.env` in this directory.
#
# Secrets and deployment endpoints only. All tunables (branding, roles,
# rate limits, invite domains, self-registration, cookies, JWT lifetime, etc.)
# live in config.py — see CONFIG.md.

DATABASE_URL=sqlite:///./app.db
JWT_SECRET=dev-secret

# Local dev only — allow weak JWT_SECRET above (not for production)
# JWT_ALLOW_WEAK_SECRET=1

# SMTP (required for invite / self-registration / reset emails)
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=

# Directory lookup service (optional)
# DIRECTORY_LOOKUP_URL=https://example.com/api/ldapEmail
# DIRECTORY_LOOKUP_CA_BUNDLE=/path/to/ca.pem

# Alembic seed users (read at migrate time only — see README.md)
# SEED_ADMIN_ENABLED=1
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=
